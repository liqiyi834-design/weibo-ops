[Unit]
Description=HotComment-AI FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=weiboops
Group=weiboops
WorkingDirectory=/opt/weibo-ops
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/weibo-ops/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
